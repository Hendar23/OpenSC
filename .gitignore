# Original game data used by development checks is supplied locally.
/Original Sub Culture/
/Extracted Original Data/

# Conversions of original game models/textures are generated locally.
/godot/assets/
/Mods/example-glb-submarine/models/
/Mods/example-png-texture/textures/

# Engine caches, script caches and generated verification output.
.godot/
__pycache__/
*.py[cod]
*.log
/godot/tests/*.png
/godot/tests/*.wav
/godot/tests/*.import
/godot/tests/capture_world.gd.uid
/godot/tests/*-fixtures/
/godot/tests/*-test.cfg

# Local capture sessions, superseded probes and optional asset-pack checks.
/godot/tests/capture_*.gd
/godot/tests/capture_*.gd.uid
/godot/tests/apply_movement_defaults.gd*
/godot/tests/research_submarine_audio.py
/godot/tests/verify_fog_render.gd*
/godot/tests/verify_bubble_mod.gd*
/godot/tests/verify_remastered_submarine.gd*
/godot/tests/verify_building_textures.gd*
/godot/tests/verify_plant_textures.gd*
/godot/tests/verify_submarine_equipment_textures.gd*
/godot/tests/verify_wildlife_textures.gd*
/godot/tests/verify_upscaled_map_textures.gd*
/godot/tests/verify_scenery_scatter.gd*
/godot/tests/verify_scenery_sessions.gd*

# Large optional texture downloads are distributed outside Git history.
/Mods/detailed-*-textures/
/Mods/upscaled-*-textures/

# Temporary files and backups.
*.7z
*.bak
*.gdoc

# Local credentials/configuration.
/.local/
# Player data if a source checkout shares the Documents/OpenSC directory.
/cache/
/settings/
/savegame/
/preferences.cfg
.env
.env.*
!.env.example
export_credentials.cfg
/dist/

# Inactive mods kept locally for storage; only /Mods is release-ready.
/Other Mods/

/Mods/clownfish/models/
/Mods/clownfish/textures/
